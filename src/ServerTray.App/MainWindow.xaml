<Window x:Class="ServerTray.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ServerTray.App" Title="ServerTray" Width="1180" Height="810" MinWidth="920" MinHeight="640" WindowStartupLocation="CenterScreen" Icon="Assets/servertray.ico" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel Margin="16,22,14,18">
   <StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="0,0,0,24"><Border Background="{DynamicResource Accent}" CornerRadius="9" Width="36" Height="36"><TextBlock Text="S" FontSize="23" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="ServerTray" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="SSH SERVER MONITOR" FontSize="9" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
    <Button Content="{x:Static local:Text.Add}" Style="{StaticResource Primary}" Click="Add_Click" Margin="0,0,0,16"/>
    <TextBox x:Name="SearchBox" TextChanged="Search_Changed" AutomationProperties.Name="{x:Static local:Text.Search}" ToolTip="{x:Static local:Text.SearchHint}" Margin="0,0,0,12"/>
    <TextBlock x:Name="ServersHeading" FontSize="11" Foreground="{DynamicResource Muted}" Margin="4,0,0,10"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0"><Button Content="{x:Static local:Text.Alerts}" Click="Alerts_Click"/><Button Content="{x:Static local:Text.Settings}" Click="Settings_Click"/><TextBlock Text="v0.1.0-preview · MIT" FontSize="10" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel>
   <ListBox x:Name="ServerList" ItemsSource="{Binding Servers}" SelectionChanged="Server_Selected" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions><Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Top" Margin="0,6,6,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{Binding StatusBrush}" Margin="0,4,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel></Border>
  <DockPanel Grid.Column="1" Margin="26,24,14,12">
   <Grid DockPanel.Dock="Top" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="{x:Static local:Text.Overview}" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="{x:Static local:Text.Tagline}" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{x:Static local:Text.Import}" Click="Import_Click"/><Button Content="{x:Static local:Text.Export}" Click="Export_Click"/><Button Content="{x:Static local:Text.Refresh}" Click="Refresh_Click"/></StackPanel></Grid>
   <TextBlock x:Name="Footer" DockPanel.Dock="Bottom" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
    <Border x:Name="DemoBanner" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" Padding="12" CornerRadius="6" Margin="0,0,12,14"><TextBlock Text="{x:Static local:Text.DemoBanner}" Foreground="{DynamicResource Accent}"/></Border>
    <UniformGrid Columns="3"><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="OnlineCaption" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Online}" FontSize="29" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="NetworkCaption" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Network}" FontSize="25" FontWeight="SemiBold" Margin="0,11,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="AttentionCaption" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Attention}" FontSize="29" FontWeight="SemiBold" Margin="0,9,0,0"/></StackPanel></Border></UniformGrid>
    <Border x:Name="EmptyPanel" Style="{StaticResource Card}" Padding="36"><StackPanel><TextBlock x:Name="EmptyTitle" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="EmptyDescription" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,20"/><Button Content="{x:Static local:Text.Add}" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="Add_Click"/></StackPanel></Border>
    <StackPanel x:Name="DetailsPanel" Visibility="Collapsed">
     <Grid Margin="0,9,12,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock x:Name="ServerTitle" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ServerStatus" Margin="12,6,0,0" FontSize="12"/></StackPanel><TextBlock x:Name="ServerMeta" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="TrustButton" Content="{x:Static local:Text.VerifyHost}" Click="Trust_Click" Visibility="Collapsed"/><Button Content="↑" Click="MoveUp_Click" ToolTip="{x:Static local:Text.MoveUp}"/><Button Content="↓" Click="MoveDown_Click" ToolTip="{x:Static local:Text.MoveDown}"/><Button Content="{x:Static local:Text.Edit}" Click="Edit_Click"/></StackPanel></Grid>
     <UniformGrid Columns="3"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{x:Static local:Text.Cpu}" Style="{StaticResource MutedText}"/><TextBlock x:Name="CpuValue" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/><ProgressBar x:Name="CpuBar" Height="4" Maximum="100" Foreground="{DynamicResource Accent}" BorderThickness="0"/><TextBlock x:Name="CpuDetail" Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{x:Static local:Text.Memory}" Style="{StaticResource MutedText}"/><TextBlock x:Name="MemoryValue" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/><ProgressBar x:Name="MemoryBar" Height="4" Maximum="100" Foreground="#5378DB" BorderThickness="0"/><TextBlock x:Name="MemoryDetail" Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{x:Static local:Text.Disk}" Style="{StaticResource MutedText}"/><TextBlock x:Name="DiskValue" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/><ProgressBar x:Name="DiskBar" Height="4" Maximum="100" Foreground="#C39138" BorderThickness="0"/><TextBlock x:Name="DiskDetail" Style="{StaticResource MutedText}" Margin="0,10,0,0"/></StackPanel></Border></UniformGrid>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="RxCaption" Style="{StaticResource MutedText}"/><TextBlock x:Name="RxValue" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="TxCaption" Style="{StaticResource MutedText}"/><TextBlock x:Name="TxValue" FontSize="20" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock x:Name="IoCaption" Style="{StaticResource MutedText}"/><TextBlock x:Name="IoValue" FontSize="12" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock x:Name="UptimeCaption" Style="{StaticResource MutedText}"/><TextBlock x:Name="UptimeValue" FontSize="16" Margin="0,9,0,0"/></StackPanel></Grid></Border>
     <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HistoryCaption" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="1h" Tag="1" Click="Range_Click"/><Button Content="6h" Tag="6" Click="Range_Click"/><Button Content="24h" Tag="24" Click="Range_Click"/><Button Content="7d" Tag="168" Click="Range_Click"/></StackPanel></Grid><TextBlock x:Name="ChartLegend" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,5,0,12"/><local:TelemetryChart x:Name="ResourceChart" Height="160"/><TextBlock x:Name="NetworkHistoryCaption" FontWeight="SemiBold" Margin="0,14,0,8"/><local:TelemetryChart x:Name="NetworkChart" Height="140"/><TextBlock x:Name="TrafficFootnote" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
    </StackPanel>
   </StackPanel></ScrollViewer>
  </DockPanel>
 </Grid>
</Window>
