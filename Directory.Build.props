<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic><Version>0.1.0-preview</Version>
    <Authors>ServerTray contributors</Authors><PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
